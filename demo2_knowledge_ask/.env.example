# Copy this file to `.env` and adjust if needed.

# --- PostgreSQL connection (the database Demo 1 ingested into) ---
DB_HOST=localhost
# Host 5433 matches demo1_offline_ingestion/docker-compose.yml.
DB_PORT=5433
DB_NAME=rag_demo
DB_USER=rag
DB_PASSWORD=ragpassword

# --- Embeddings: MUST match what Demo 1 used, or retrieval breaks ---
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=

# --- Retrieval ---
TOP_K=4
# Retrieval gate: below this best-match similarity we refuse without an LLM call.
MIN_SIMILARITY=0.72

# --- Answer generation ---
# "stub"   = offline, no API key, quotes the retrieved chunks (default for class)
# "openai" = real LLM call, requires OPENAI_API_KEY
LLM_PROVIDER=stub
LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
