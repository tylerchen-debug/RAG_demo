# Copy this file to `.env` and adjust if needed.

# --- PostgreSQL connection ---
DB_HOST=localhost
# Host 5433 avoids clashing with a native postgres on 5432 (see docker-compose.yml).
DB_PORT=5433
DB_NAME=rag_demo
DB_USER=rag
DB_PASSWORD=ragpassword

# --- Embedding provider ---
# "fastembed" = local model, runs offline, no API key (default)
# "openai"    = OpenAI embeddings API (requires OPENAI_API_KEY)
EMBEDDING_PROVIDER=fastembed

# Leave blank to use the provider's default model.
# fastembed default: BAAI/bge-small-en-v1.5  (384 dims)
# openai default:    text-embedding-3-small  (1536 dims)
EMBEDDING_MODEL=

# Required only when EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# --- Chunking ---
CHUNK_MAX_CHARS=800
CHUNK_OVERLAP_CHARS=150
